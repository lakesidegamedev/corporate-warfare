<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Mac App Store requires the sandbox. Saves live in the app's own container. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Anonymous market snapshots to the Lakeside ops ingest, as on iPhone. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- The Lakeside sign-in: the browser hands its one-time code back to 127.0.0.1. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- The in-game update saves the verified disk image to Downloads. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
</dict>
</plist>
