      "title": "Energy outage",
      "trigger": "random_energy_region",
      "mandatory": false,
      "cooldown_weeks": 26,
      "choices": [
        { "id": "backup", "label": "Pay two weeks of normal power expense for backup supply", "handler": "buy_backup_power" },
        { "id": "accept", "label": "Accept half capacity for two weeks with no extra fee", "handler": "accept_power_cut" }
      ]
    },
    {
      "id": "fuel_spike",
      "title": "Fuel spike",
