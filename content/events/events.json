      "trigger": "supplier_restructuring",
      "mandatory": false,
      "cooldown_weeks": 26,
      "choices": [
        { "id": "terminate", "label": "Terminate future deliveries and claim the escrow refund", "handler": "terminate_supplier_contract" },
        { "id": "wait", "label": "Keep the claim and wait for the supplier's restructuring", "handler": "keep_supplier_claim" }
      ]
    },
    {
